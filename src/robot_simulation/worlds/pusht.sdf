<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pusht">
    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <iters>40</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.55</ambient>
      <background>0.72 0.76 0.80</background>
    </scene>

    <include>
      <uri>model://ground plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Push-T work surface. The robot is spawned at the world origin by simulation.launch.py. -->
    <model name="pusht_table">
      <static>true</static>
      <pose>0.55 0 0.39 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>0.90 0.70 0.04</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>0.90 0.70 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.84 0.84 0.78 1</ambient>
            <diffuse>0.84 0.84 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Green target region. This is visual-only so it does not disturb pushing dynamics. -->
    <model name="pusht_target_zone">
      <static>true</static>
      <pose>0.72 0.13 0.413 0 0 0.7853981634</pose>
      <link name="target_link">
        <visual name="target_bar_long">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.26 0.07 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.70 0.28 0.55</ambient>
            <diffuse>0.10 0.70 0.28 0.55</diffuse>
          </material>
        </visual>
        <visual name="target_bar_short">
          <pose>-0.095 0.075 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.07 0.22 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.70 0.28 0.55</ambient>
            <diffuse>0.10 0.70 0.28 0.55</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Movable T block used by the Push-T task. -->
    <model name="pusht_t_block">
      <static>false</static>
      <pose>0.50 -0.12 0.445 0 0 -0.35</pose>
      <link name="t_block_link">
        <inertial>
          <mass>0.25</mass>
          <inertia>
            <ixx>0.0012</ixx>
            <iyy>0.0012</iyy>
            <izz>0.0018</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="bar_long_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.24 0.06 0.06</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.65</mu>
                <mu2>0.65</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <collision name="bar_short_collision">
          <pose>-0.09 0.075 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.21 0.06</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.65</mu>
                <mu2>0.65</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="bar_long_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.24 0.06 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.88 0.12 0.12 1</ambient>
            <diffuse>0.88 0.12 0.12 1</diffuse>
          </material>
        </visual>
        <visual name="bar_short_visual">
          <pose>-0.09 0.075 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.21 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.88 0.12 0.12 1</ambient>
            <diffuse>0.88 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Small movable puck for early planar pushing tests before using the T block. -->
    <model name="pusht_debug_puck">
      <static>false</static>
      <pose>0.38 0.16 0.445 0 0 0</pose>
      <link name="puck_link">
        <inertial>
          <mass>0.12</mass>
          <inertia>
            <ixx>0.0002</ixx>
            <iyy>0.0002</iyy>
            <izz>0.0002</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="puck_collision">
          <geometry>
            <cylinder>
              <radius>0.035</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.55</mu>
                <mu2>0.55</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="puck_visual">
          <geometry>
            <cylinder>
              <radius>0.035</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.12 0.24 0.88 1</ambient>
            <diffuse>0.12 0.24 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
