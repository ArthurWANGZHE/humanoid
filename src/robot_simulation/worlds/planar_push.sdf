<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="planar_push">
    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <iters>60</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.58 0.58 0.58</ambient>
      <background>0.72 0.76 0.80</background>
    </scene>

    <include>
      <uri>model://ground plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="push_table">
      <static>true</static>
      <pose>0.45 0 0.39 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>0.70 0.55 0.04</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>0.70 0.55 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.82 0.76 1</ambient>
            <diffuse>0.82 0.82 0.76 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="target_square">
      <static>true</static>
      <pose>0.55 0.13 0.414 0 0 0</pose>
      <link name="target_link">
        <visual name="front_edge">
