          <geometry>
            <box>
              <size>0.18 0.012 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.65 0.20 1</ambient>
            <diffuse>0.05 0.65 0.20 1</diffuse>
          </material>
        </visual>
        <visual name="back_edge">
          <pose>0 -0.09 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 0.012 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.65 0.20 1</ambient>
            <diffuse>0.05 0.65 0.20 1</diffuse>
          </material>
        </visual>
        <visual name="left_edge">
          <pose>-0.09 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.012 0.18 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.65 0.20 1</ambient>
            <diffuse>0.05 0.65 0.20 1</diffuse>
          </material>
        </visual>
        <visual name="right_edge">
          <pose>0.09 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.012 0.18 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.65 0.20 1</ambient>
            <diffuse>0.05 0.65 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="red_block">
      <static>false</static>
      <pose>0.38 -0.05 0.445 0 0 0</pose>
      <link name="block_link">
        <inertial>
          <mass>0.16</mass>
          <inertia>
            <ixx>0.00009</ixx>
            <iyy>0.00009</iyy>
            <izz>0.00009</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="block_collision">
          <geometry>
            <box>
              <size>0.06 0.06 0.06</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.45</mu>
                <mu2>0.45</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="block_visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.88 0.08 0.06 1</ambient>
            <diffuse>0.88 0.08 0.06 1</diffuse>
          </material>
